# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=200
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_STACK_SIZE=4096
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_CHECK_MUTEX_GIVEN_BY_OWNER=n
CONFIG_LWIP_LOCAL_HOSTNAME="Meadow"
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SYNMAXRTX=6
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_LITTLEFS_FLUSH_FILE_EVERY_WRITE=y
#
#   Keep writing LittleFS on-disk version 2.0.  The littlefs component 1.23.1 (LittleFS 2.11)
#   writes version 2.1 by default, as every LittleFS from 2.6 does, upgrading a 2.0 partition
#   on its first write.  Firmware built with component 1.5.5 (LittleFS 2.5, the ESP-IDF 5.5
#   releases) cannot mount 2.1, and FileSystem formats a partition it cannot mount, so going
#   back to such a release would erase the certificates and keys stored there.  Version 2.0
#   loses only the forward-looking erase-state checksums.
#
CONFIG_LITTLEFS_MULTIVERSION=y
CONFIG_LITTLEFS_DISK_VERSION_2_0=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
#
#   CONFIG_COMPILER_STACK_CHECK_MODE_ALL runs out of IRAM.
#
# CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y