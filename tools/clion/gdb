#!/usr/bin/env bash
# tools/clion/gdb -- machine-independent xtensa-esp32-elf-gdb for CLion's
# "Debug (OpenOCD)" run configuration.
#
# Finds the GDB that matches the active ESP-IDF through idf-env.sh, so the
# committed run configuration carries no machine or version specific path.
# Arguments are passed through.  Nothing may be written to stdout before exec:
# CLion talks to GDB over MI on stdout.
#
# Selection, first match wins:
#   IDF_GDB=/path/to/gdb            use this binary
#   IDF_ACTIVATE=/path/activate.sh  use this IDF activation script
#   IDF_VERSION=x.y                 use ~/.espressif/tools/activate_idf_vx.y.sh
#   (default)                       IDF 6.1
#
# Set these in your login shell (CLion reads it at startup on macOS) or in
# tools/clion/tools.local.env, which is not committed.

set -euo pipefail
_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
[ -f "$_here/tools.local.env" ] && . "$_here/tools.local.env"
# shellcheck source=idf-env.sh
. "$_here/idf-env.sh" >&2

exec "${IDF_GDB:-xtensa-esp32-elf-gdb}" "$@"
