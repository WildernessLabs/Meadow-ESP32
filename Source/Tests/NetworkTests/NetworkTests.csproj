<Project Sdk="Meadow.Sdk/1.1.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Exe</OutputType>
    <AssemblyName>App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meadow.Foundation" Version="0.*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Meadow.F7" />
    <None Remove="Meadow" />
    <None Remove="Meadow.Contracts" />
    <None Remove="Meadow.Units" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Meadow.F7">
      <HintPath>References\Meadow.F7.dll</HintPath>
    </Reference>
    <Reference Include="Meadow">
      <HintPath>References\Meadow.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.Contracts">
      <HintPath>References\Meadow.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.Units">
      <HintPath>References\Meadow.Units.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>