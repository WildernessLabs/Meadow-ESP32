#
#   SEGGER SystemView tracing over JTAG.
#
#   Merged after the other configuration files when build.sh (or test/build.sh) is given
#   --sysview.  See Documentation/Diagnostics.md for how to capture and view a trace.
#
#   From ESP-IDF 6 SystemView is not part of ESP-IDF.  It is the espressif/esp_sysview managed
#   component (components/F7Services/idf_component.yml), which the esp_trace component loads
#   as its external trace library.  The component builds to nothing unless this file selects
#   it, so the other builds are unaffected by the dependency.
#
#   Application level tracing (esp_trace's apptrace transport) sends the trace data to the
#   host through the JTAG interface (the ESP-Prog), where OpenOCD writes it to a file that
#   SystemView opens.
#
CONFIG_ESP_TRACE_LIB_EXTERNAL=y
CONFIG_ESP_TRACE_TRANSPORT_APPTRACE=y
CONFIG_APPTRACE_DEST_JTAG=y

#
#   A hardware timer gives both cores the same time base, so events from the two cores line
#   up in the trace.
#
CONFIG_ESP_TRACE_TS_SOURCE_GPTIMER=y

#
#   How long a task waits for room in the trace buffer before the event is dropped (and an
#   overflow event recorded), in microseconds.  -1 would make it wait for ever, stopping the
#   application whenever the host stops reading.
#
CONFIG_SEGGER_SYSVIEW_BUF_WAIT_TMO=500

#
#   Making room in IRAM.
#
#   The trace hooks run inside the scheduler and the interrupt handlers, so SystemView and
#   application tracing put code in IRAM.  ESP-IDF 6 already places the FreeRTOS and ring
#   buffer functions in flash in every build, so only the heap functions are moved here.  The
#   functions an interrupt handler may call stay in IRAM.  The cost is that a call can now
#   miss the flash cache, which adds a little time to heap calls in a traced build: keep that
#   in mind when reading very short spans.
#
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

CONFIG_SEGGER_SYSVIEW_MAX_TASKS=32
CONFIG_SEGGER_SYSVIEW_EVT_OVERFLOW_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_ISR_ENTER_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_ISR_EXIT_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_ISR_TO_SCHED_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_START_EXEC_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_STOP_EXEC_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_START_READY_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_STOP_READY_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_CREATE_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TASK_TERMINATE_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_IDLE_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TIMER_ENTER_ENABLE=y
CONFIG_SEGGER_SYSVIEW_EVT_TIMER_EXIT_ENABLE=y
